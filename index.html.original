    <!-- REACT COMPONENTS (Full Implementation) -->
    <script type="text/babel">
        const { useState } = React;

        // 1. FAQ Component
        const FAQAccordion = () => {
            const faqData = [
                { question: "Siapa yang dapat mengikuti ALIES?", answer: "Peserta tingkat SD/MI sederajat sesuai dengan ketentuan dan persyaratan teknis panitia penyelenggara." },
                { question: "Apa saja cabang lombanya?", answer: "Cabang lomba yang dilombakan meliputi IPA, Matematika, Bahasa Inggris, dan Bahasa Arab." },
                { question: "Bagaimana cara mendaftar?", answer: "Klik tombol “Daftar Sekarang” yang tersedia di website ini dan ikuti formulir pendaftaran serta petunjuk selanjutnya." },
                { question: "Bagaimana jika mengalami kendala?", answer: "Hubungi Customer Service melalui kontak WhatsApp, Instagram, atau Email resmi yang tertera pada bagian bawah halaman." }
            ];

            const [openIndices, setOpenIndices] = useState([]);

            const toggleAccordion = (index) => {
                if (openIndices.includes(index)) {
                    setOpenIndices(openIndices.filter(i => i !== index));
                } else {
                    setOpenIndices([...openIndices, index]);
                }
            };

            return (
                <div className="space-y-4">
                    {faqData.map((item, index) => {
                        const isOpen = openIndices.includes(index);
                        return (
                            <div key={index} className="bg-white rounded-2xl border border-primarymed/15 overflow-hidden shadow-sm hover-trigger cursor-none">
                                <button 
                                    onClick={() => toggleAccordion(index)}
                                    className="w-full px-6 py-5 text-left font-heading font-bold text-primarydark flex justify-between items-center focus:outline-none"
                                >
                                    <span>{item.question}</span>
                                    <i className={`fa-solid fa-chevron-down text-sm transition-transform duration-300 ${isOpen ? 'rotate-180' : ''}`}></i>
                                </button>
                                {isOpen && (
                                    <div className="px-6 pb-5 text-sm text-charcoalgrey/80 leading-relaxed border-t border-gray-100 pt-3">
                                        {item.answer}
                                    </div>
                                )}
                            </div>
                        );
                    })}
                </div>
            );
        };

        // 2. Contact Form Component
        const ContactForm = () => {
            const [formData, setFormData] = useState({
                name: '', email: '', whatsapp: '', school: '', message: ''
            });
            const [touched, setTouched] = useState({});
            const [isSuccess, setIsSuccess] = useState(false);

            const validate = (data) => {
                const errors = {};
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                const waRegex = /^[0-9]{10,15}$/;

                if (!data.name.trim()) errors.name = "Nama lengkap wajib diisi.";
                if (!emailRegex.test(data.email.trim())) errors.email = "Masukkan alamat email yang valid.";
                if (!waRegex.test(data.whatsapp.trim())) errors.whatsapp = "Nomor WhatsApp minimal 10 digit angka.";
                if (!data.school.trim()) errors.school = "Asal sekolah wajib diisi.";
                if (data.message.trim().length < 10) errors.message = "Pesan minimal berisi 10 karakter.";
                return errors;
            };

            const errors = validate(formData);

            const handleChange = (e) => {
                const { name, value } = e.target;
                setFormData(prev => ({ ...prev, [name]: value }));
            };

            const handleBlur = (e) => {
                const { name } = e.target;
                setTouched(prev => ({ ...prev, [name]: true }));
            };

            const handleSubmit = (e) => {
                e.preventDefault();
                setTouched({ name: true, email: true, whatsapp: true, school: true, message: true });

                if (Object.keys(errors).length === 0) {
                    setIsSuccess(true);
                    setFormData({ name: '', email: '', whatsapp: '', school: '', message: '' });
                    setTouched({});
                    setTimeout(() => setIsSuccess(false), 6000);
                }
            };

            return (
                <div className="bg-white rounded-3xl p-8 sm:p-12 shadow-xl shadow-primarydark/5 border border-primarymed/15 relative">
                    {isSuccess && (
                        <div className="mb-6 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-sm font-medium flex items-center gap-3">
                            <i className="fa-solid fa-circle-check text-primarymed text-lg"></i>
                            <span>Pesan berhasil terkirim! Terima kasih telah menghubungi panitia ALIES 2027.</span>
                        </div>
                    )}

                    <form onSubmit={handleSubmit} noValidate className="space-y-6">
                        <div>
                            <label htmlFor="name" className="block text-sm font-bold text-primarydark mb-2">Nama Lengkap</label>
                            <input 
                                type="text" id="name" name="name" 
                                value={formData.name} onChange={handleChange} onBlur={handleBlur}
                                placeholder="Masukkan nama lengkap" 
                                className={`w-full px-4 py-3.5 rounded-xl border focus:outline-none focus:border-primarydark text-sm transition-smooth hover-trigger cursor-none ${touched.name && errors.name ? 'border-rose-500' : 'border-gray-200'}`}
                            />
                            {touched.name && errors.name && <p className="text-xs text-rose-500 mt-1.5">{errors.name}</p>}
                        </div>

                        <div>
                            <label htmlFor="email" className="block text-sm font-bold text-primarydark mb-2">Email</label>
                            <input 
                                type="email" id="email" name="email" 
                                value={formData.email} onChange={handleChange} onBlur={handleBlur}
                                placeholder="nama@example.com" 
                                className={`w-full px-4 py-3.5 rounded-xl border focus:outline-none focus:border-primarydark text-sm transition-smooth hover-trigger cursor-none ${touched.email && errors.email ? 'border-rose-500' : 'border-gray-200'}`}
                            />
                            {touched.email && errors.email && <p className="text-xs text-rose-500 mt-1.5">{errors.email}</p>}
                        </div>

                        <div>
                            <label htmlFor="whatsapp" className="block text-sm font-bold text-primarydark mb-2">Nomor WhatsApp</label>
                            <input 
                                type="tel" id="whatsapp" name="whatsapp" 
                                value={formData.whatsapp} onChange={handleChange} onBlur={handleBlur}
                                placeholder="08xxxxxxxxxx" 
                                className={`w-full px-4 py-3.5 rounded-xl border focus:outline-none focus:border-primarydark text-sm transition-smooth hover-trigger cursor-none ${touched.whatsapp && errors.whatsapp ? 'border-rose-500' : 'border-gray-200'}`}
                            />
                            {touched.whatsapp && errors.whatsapp && <p className="text-xs text-rose-500 mt-1.5">{errors.whatsapp}</p>}
                        </div>

                        <div>
                            <label htmlFor="school" className="block text-sm font-bold text-primarydark mb-2">Asal Sekolah</label>
                            <input 
                                type="text" id="school" name="school" 
                                value={formData.school} onChange={handleChange} onBlur={handleBlur}
                                placeholder="Nama SD / MI Sederajat" 
                                className={`w-full px-4 py-3.5 rounded-xl border focus:outline-none focus:border-primarydark text-sm transition-smooth hover-trigger cursor-none ${touched.school && errors.school ? 'border-rose-500' : 'border-gray-200'}`}
                            />
                            {touched.school && errors.school && <p className="text-xs text-rose-500 mt-1.5">{errors.school}</p>}
                        </div>

                        <div>
                            <label htmlFor="message" className="block text-sm font-bold text-primarydark mb-2">Pesan</label>
                            <textarea 
                                id="message" name="message" rows="4" 
                                value={formData.message} onChange={handleChange} onBlur={handleBlur}
                                placeholder="Tuliskan pertanyaan atau pesan Anda..." 
                                className={`w-full px-4 py-3.5 rounded-xl border focus:outline-none focus:border-primarydark text-sm transition-smooth resize-none hover-trigger cursor-none ${touched.message && errors.message ? 'border-rose-500' : 'border-gray-200'}`}
                            ></textarea>
                            {touched.message && errors.message && <p className="text-xs text-rose-500 mt-1.5">{errors.message}</p>}
                        </div>

                        <button type="submit" className="w-full py-4 bg-primarydark text-white font-bold rounded-xl shadow-md hover:bg-primarymed transition-smooth hover-trigger cursor-none">
                            Kirim Pesan
                        </button>
                    </form>
                </div>
            );
        };

        // Render Components
        ReactDOM.createRoot(document.getElementById('faq-react-root')).render(<FAQAccordion />);
        ReactDOM.createRoot(document.getElementById('contact-react-root')).render(<ContactForm />);
    </script>

    <!-- GSAP & LOGIKA VANILLA JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script>
        // 1. Lenis Smooth Scroll Setup
        const lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), 
            direction: 'vertical',
            gestureDirection: 'vertical',
            smooth: true,
            mouseMultiplier: 1,
            smoothTouch: false,
            touchMultiplier: 2,
        });

        function raf(time) {
            lenis.raf(time);
            requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // 2. Custom Cursor & Magnetic Elements (Desktop Only)
        const cursor = document.getElementById('custom-cursor');
        
        if (window.matchMedia("(pointer: fine)").matches) {
            document.addEventListener('mousemove', (e) => {
                cursor.style.left = e.clientX + 'px';
                cursor.style.top = e.clientY + 'px';
            });

            // Delegate hover events dynamically to cover React elements
            document.body.addEventListener('mouseover', (e) => {
                if(e.target.closest('.hover-trigger') || e.target.closest('a') || e.target.closest('button')) {
                    cursor.classList.add('hovered');
                }
            });
            document.body.addEventListener('mouseout', (e) => {
                if(e.target.closest('.hover-trigger') || e.target.closest('a') || e.target.closest('button')) {
                    cursor.classList.remove('hovered');
                }
            });

            const magneticElements = document.querySelectorAll('.magnetic-element');
            magneticElements.forEach(elem => {
                elem.addEventListener('mousemove', (e) => {
                    const rect = elem.getBoundingClientRect();
                    const strength = elem.getAttribute('data-magnetic-strength') || 20;
                    const x = ((e.clientX - rect.left) / rect.width - 0.5) * strength;
                    const y = ((e.clientY - rect.top) / rect.height - 0.5) * strength;
                    gsap.to(elem, { x: x, y: y, duration: 0.5, ease: 'power2.out' });
                });
                elem.addEventListener('mouseleave', () => {
                    gsap.to(elem, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.3)' });
                });
            });
        }

        // 3. Preloader & GSAP Initialization
        gsap.registerPlugin(ScrollTrigger);
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => { lenis.raf(time * 1000) });
        gsap.ticker.lagSmoothing(0);

        window.addEventListener('load', () => {
            const tl = gsap.timeline();
            tl.to("#loader-bar", { width: "100%", duration: 1, ease: "power3.inOut" })
              .to("#loader-heading", { y: -100, opacity: 0, duration: 0.6, ease: "power2.in" })
              .to("#preloader", { yPercent: -100, duration: 0.8, ease: "power4.inOut" }, "-=0.3")
              .to(".hero-elem", { autoAlpha: 1, y: 0, duration: 1, stagger: 0.15, ease: "power3.out", startAt: { y: 40, autoAlpha: 0 } }, "-=0.2")
              .to(".hero-visual", { autoAlpha: 1, scale: 1, duration: 1.2, ease: "back.out(1.5)", startAt: { scale: 0.85, autoAlpha: 0 } }, "-=0.8");
        });

        // 4. Scroll Animations (Parallax & Reveal)
        gsap.utils.toArray('.hero-parallax').forEach(layer => {
            const speed = layer.getAttribute('data-speed');
            gsap.to(layer, {
                y: () => (ScrollTrigger.maxScroll(window) * speed),
                ease: "none",
                scrollTrigger: { trigger: "#home", start: "top top", end: "bottom top", scrub: true }
            });
        });

        gsap.to(".about-content", { scrollTrigger: { trigger: "#about", start: "top 75%" }, autoAlpha: 1, x: 0, duration: 1, startAt: { x: -40, autoAlpha: 0 }, ease: "power2.out" });
        gsap.to(".about-card", { scrollTrigger: { trigger: "#about", start: "top 75%" }, autoAlpha: 1, x: 0, duration: 1, startAt: { x: 40, autoAlpha: 0 }, ease: "power2.out", delay: 0.2 });
        gsap.to(".values-header", { scrollTrigger: { trigger: ".values-header", start: "top 80%" }, autoAlpha: 1, y: 0, duration: 0.8, startAt: { y: 25, autoAlpha: 0 } });
        gsap.to(".value-card", { scrollTrigger: { trigger: ".values-header", start: "top 75%" }, autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.12, startAt: { y: 30, autoAlpha: 0 }, ease: "power2.out" });
        gsap.to(".cat-header", { scrollTrigger: { trigger: ".cat-header", start: "top 80%" }, autoAlpha: 1, y: 0, duration: 0.8, startAt: { y: 25, autoAlpha: 0 } });
        gsap.to(".cat-card", { scrollTrigger: { trigger: ".cat-header", start: "top 75%" }, autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.12, startAt: { y: 35, autoAlpha: 0 }, ease: "power2.out" });
        gsap.to(".benefit-header", { scrollTrigger: { trigger: ".benefit-header", start: "top 80%" }, autoAlpha: 1, y: 0, duration: 0.8, startAt: { y: 25, autoAlpha: 0 } });
        gsap.to(".benefit-card", { scrollTrigger: { trigger: ".benefit-header", start: "top 75%" }, autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.1, startAt: { y: 30, autoAlpha: 0 }, ease: "power2.out" });
        gsap.to(".gallery-header", { scrollTrigger: { trigger: ".gallery-header", start: "top 80%" }, autoAlpha: 1, y: 0, duration: 0.8, startAt: { y: 25, autoAlpha: 0 } });
        gsap.to(".gallery-item", { scrollTrigger: { trigger: ".gallery-header", start: "top 75%" }, autoAlpha: 1, scale: 1, duration: 0.8, stagger: 0.15, startAt: { scale: 0.95, autoAlpha: 0 }, ease: "power2.out" });
        gsap.to(".faq-header", { scrollTrigger: { trigger: ".faq-header", start: "top 80%" }, autoAlpha: 1, y: 0, duration: 0.8, startAt: { y: 25, autoAlpha: 0 } });
        gsap.to(".faq-list", { scrollTrigger: { trigger: ".faq-header", start: "top 75%" }, autoAlpha: 1, y: 0, duration: 0.8, startAt: { y: 30, autoAlpha: 0 }, ease: "power2.out" });

        // 5. Navbar & Mobile Menu
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 20) {
                navbar.classList.remove('navbar-transparent');
                navbar.classList.add('navbar-scrolled');
            } else {
                navbar.classList.remove('navbar-scrolled');
                navbar.classList.add('navbar-transparent');
            }
        });

        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');
        const mobileIcon = mobileMenuBtn.querySelector('i');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
            if (mobileMenu.classList.contains('hidden')) {
                mobileIcon.classList.remove('fa-xmark');
                mobileIcon.classList.add('fa-bars');
            } else {
                mobileIcon.classList.remove('fa-bars');
                mobileIcon.classList.add('fa-xmark');
            }
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                mobileIcon.classList.remove('fa-xmark');
                mobileIcon.classList.add('fa-bars');
            });
        });
    </script>
</body>
</html>